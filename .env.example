# PaperLens environment example (copy to .env and fill in locally)
# Never commit real API keys or connection strings.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=runtime/outputs

GCP_PROJECT_ID=paperlens-dev-26
GCS_BUCKET_NAME=paperlens-dev-26-paper-storage

DOCLING_OCR_MODE=auto
DOCLING_IMAGES_SCALE=1.5
DOCLING_THREADS=1
DOCLING_ACCELERATOR_DEVICE=auto
DOCLING_CUDA_USE_FLASH_ATTENTION2=false
DOCLING_DO_FORMULA_ENRICHMENT=false
DOCLING_DO_CODE_ENRICHMENT=false

LUNA_ENABLED=false
LUNA_PROVIDER=openai
LUNA_MODEL=
LUNA_API_KEY=
LUNA_BASE_URL=
LUNA_MAX_RETRIES=2
LUNA_REQUEST_DELAY_SECONDS=1
LUNA_TIMEOUT_SECONDS=60
LUNA_PROMPT_VERSION=v1
LUNA_SCHEMA_VERSION=v1
TEXT_ENRICHMENT_ENABLED=false
TEXT_ENRICHMENT_MODEL=
TEXT_ENRICHMENT_MAX_SECTIONS=8
TEXT_ENRICHMENT_MAX_CHARS_PER_SECTION=6000
TEXT_ENRICHMENT_MAX_TOTAL_CHARS=30000
INGEST_AUTO_TEXT_ENRICH=false
ALLOW_EXTERNAL_API=false

MAX_PDF_SIZE_MB=50
ASSET_CROP_PADDING_PX=8
LOG_LEVEL=INFO

# Database
# Prefer DATABASE_URL. SUPABASE_URL is accepted as a Postgres DSN fallback when it starts with postgresql://
# Transaction pooler (recommended runtime): host *.pooler.supabase.com port 6543
# Session pooler / direct (preferred for migrations if needed): port 5432
# DATABASE_URL=sqlite:///./runtime/data/paperlens.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=sqlite:///./runtime/data/paperlens.db
# SUPABASE_URL=
# MIGRATION_DATABASE_URL=
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
INGEST_ASYNC=false

# Supabase email authentication. Keep disabled until the v0.2 migration has run.
AUTH_ENABLED=false
SUPABASE_AUTH_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# Legacy aliases SUPABASE_ANON_KEY and SUPABASE_JWT_SECRET remain supported.

# Anonymous try-before-signup trial (only used when AUTH_ENABLED=true).
GUEST_TRIAL_ENABLED=true
GUEST_MAX_QUERIES=10
GUEST_MAX_PAPERS=2
GUEST_MAX_IMAGES=2
GUEST_SESSION_TTL_HOURS=72

# Embeddings / retrieval
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=384
RETRIEVAL_TOP_K=8
RETRIEVAL_USE_MMR=false

# Grounded QA synthesis through LangChain ChatOpenAI.
# If disabled or unavailable, PaperLens safely falls back to extractive QA.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

PAPERLENS_API_BASE=http://127.0.0.1:8000
LANGSMITH_ENABLED=false
LANGSMITH_TRACING=false
ALLOW_PAID_EVALUATION=false

# Unified agent guardrail limits
AGENT_MAX_MESSAGE_CHARS=8000
AGENT_MAX_SELECTED_PAPERS=8
AGENT_MAX_IMAGE_BYTES=2097152
AGENT_HISTORY_LIMIT=24
AGENT_REASONING_ENABLED=true
AGENT_REASONING_EFFORT=medium

# PaperLens environment example (copy to .env and fill in locally)
# Never commit real API keys.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=outputs

GCP_PROJECT_ID=paperlens-dev-26
GCS_BUCKET_NAME=paperlens-dev-26-paper-storage

DOCLING_OCR_MODE=auto
DOCLING_IMAGES_SCALE=1.5
DOCLING_THREADS=1
DOCLING_DO_FORMULA_ENRICHMENT=false
DOCLING_DO_CODE_ENRICHMENT=false

LUNA_ENABLED=false
LUNA_PROVIDER=openai
LUNA_MODEL=
LUNA_API_KEY=
LUNA_BASE_URL=
LUNA_MAX_RETRIES=2
LUNA_REQUEST_DELAY_SECONDS=1
LUNA_TIMEOUT_SECONDS=60
LUNA_PROMPT_VERSION=v1
LUNA_SCHEMA_VERSION=v1
ALLOW_EXTERNAL_API=false

MAX_PDF_SIZE_MB=50
ASSET_CROP_PADDING_PX=8
LOG_LEVEL=INFO

# Database: SQLite for local/dev; Supabase Postgres for cloud
# Examples:
# DATABASE_URL=sqlite:///./data/paperlens.db
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/paperlens.db
DATABASE_ECHO=false
INGEST_ASYNC=false

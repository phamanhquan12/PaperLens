# PaperLens environment example (copy to .env and fill in locally)
# Never commit real API keys or connection strings.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=outputs

GCP_PROJECT_ID=paperlens-dev-26
GCS_BUCKET_NAME=paperlens-dev-26-paper-storage

DOCLING_OCR_MODE=auto
DOCLING_IMAGES_SCALE=1.5
DOCLING_THREADS=1
DOCLING_DO_FORMULA_ENRICHMENT=false
DOCLING_DO_CODE_ENRICHMENT=false

LUNA_ENABLED=false
LUNA_PROVIDER=openai
LUNA_MODEL=
LUNA_API_KEY=
LUNA_BASE_URL=
LUNA_MAX_RETRIES=2
LUNA_REQUEST_DELAY_SECONDS=1
LUNA_TIMEOUT_SECONDS=60
LUNA_PROMPT_VERSION=v1
LUNA_SCHEMA_VERSION=v1
ALLOW_EXTERNAL_API=false

MAX_PDF_SIZE_MB=50
ASSET_CROP_PADDING_PX=8
LOG_LEVEL=INFO

# Database
# Prefer DATABASE_URL. SUPABASE_URL is accepted as a Postgres DSN fallback when it starts with postgresql://
# Transaction pooler (recommended runtime): host *.pooler.supabase.com port 6543
# Session pooler / direct (preferred for migrations if needed): port 5432
# DATABASE_URL=sqlite:///./data/paperlens.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=sqlite:///./data/paperlens.db
# SUPABASE_URL=
# MIGRATION_DATABASE_URL=
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
INGEST_ASYNC=false

# Embeddings / retrieval
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=384
RETRIEVAL_TOP_K=8
RETRIEVAL_USE_MMR=false

PAPERLENS_API_BASE=http://127.0.0.1:8000
LANGSMITH_ENABLED=false
LANGSMITH_TRACING=false
ALLOW_PAID_EVALUATION=false
